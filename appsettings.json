{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=product.db"
  },

  "ProductSettings": {
    "DefaultSortBy": "id",
    "DefaultSortOrder": "asc",
    "DefaultPageSize": 10,
    "MaxPageSize": 100
  },
  "AuthSettings": {
    "Issuer": "ProductApi",
    "Audience": "ProductApiClient",
    "ExpirationMinutes": 60
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
